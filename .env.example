# ============================================================================
# backup.sh configuration template
# Copy this file to .env (same directory as backup.sh) and edit it.
# Lines starting with '#' are comments and are ignored by the script.
# Priority: system environment variables > this file > built-in defaults.
# Quote values that contain spaces or '#', e.g. COMMAND="echo hello world".
# ============================================================================

# Command executed to stop the application before the data is archived.
# Required for backup mode; also used by restore mode when set.
STOP_COMMAND=

# Command executed to start the application after the data is archived.
# Required for backup mode; required by restore mode when STOP_COMMAND is set.
START_COMMAND=

# Directory that contains the data to back up and restore into.
# A relative path resolves against the directory of backup.sh.
SOURCE_DIR=

# Directory that receives the backup archives. Created automatically.
# A relative path resolves against the directory of backup.sh.
BACKUP_DIR=

# Hooks run around the backup. Each hook accepts one unnumbered command
# plus up to 10 numbered commands (_1 .. _10). Execution order: the
# unnumbered command first, then _1 through _10 in ascending order.
# Empty or unset entries are skipped without stopping the chain.
# Each command runs in an isolated subshell; a failure is logged as a
# warning and does not abort the backup. Backup mode only.

# Commands executed before the service stop and the archive step
# (e.g. a database dump, garbage collection). Optional.
PRE_BACKUP_COMMAND=
# PRE_BACKUP_COMMAND_1=
# PRE_BACKUP_COMMAND_2=
# ... up to PRE_BACKUP_COMMAND_10

# Commands executed after the archive is verified and the service is
# started (e.g. final cleanup). Optional.
POST_BACKUP_COMMAND=
# POST_BACKUP_COMMAND_1=
# POST_BACKUP_COMMAND_2=
# ... up to POST_BACKUP_COMMAND_10

# Number of newest archives and logs to keep. Older files are deleted.
# Must be a positive integer. Default: 30.
MAX_BACKUPS=30

# Prefix for archive and log file names. Default: app.
BACKUP_PREFIX=app

# Directory for run logs and the lock file. Created automatically.
# A relative path resolves against the directory of backup.sh. Default: ./logs/.
LOG_DIR=./logs/

# Deprecated short-name aliases are still accepted by the script:
#   STOP_CMD, START_CMD, SRC_DIR
# The full names above always win when both are set.
